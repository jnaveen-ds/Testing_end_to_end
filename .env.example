# Local defaults: deterministic, offline, and free.
DATABASE_URL=sqlite:///./local.db
REDIS_URL=redis://localhost:6379/0
LLM_PROVIDER=fake

# App 1 chat cache. Docker Compose overrides CHAT_CACHE_BACKEND to redis.
CHAT_CACHE_BACKEND=memory
CHAT_CACHE_TTL_SECONDS=900
CHAT_PROMPT_VERSION=v1
CHAT_TENANT_SCOPE=public-learning-demo

# Required only when LLM_PROVIDER=azure. Never put real credentials in this file.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_AUTH=api_key
# In Azure, use managed_identity and optionally set the client ID for a user-assigned identity.
AZURE_MANAGED_IDENTITY_CLIENT_ID=
